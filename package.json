{
  "name": "dr-abc",
  "private": true,
  "version": "1.0.18",
  "description": "Dr.ABC — Mörbius Multi-Agent Medical AI Platform",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run scripts/dev-all.ts",
    "dev:apps": "bun run --filter '*' dev",
    "dev:api": "bun run --filter @dr-abc/api dev",
    "dev:web": "bun run --filter @dr-abc/web dev",
    "dev:py": "uv run --directory apps/py-svc uvicorn app.main:app --host 0.0.0.0 --port 8001 --reload",
    "build": "bun run --filter '*' build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "spine:smoke": "bun run scripts/smoke-test.ts",
    "morbius:tune": "bun run scripts/morbius-tune.ts",
    "morbius:kg-finetune": "bun run scripts/morbius-kg-finetune.ts",
    "morbius:accuracy": "bun run scripts/accuracy-harness.ts",
    "morbius:autopilot": "bun run scripts/morbius-autopilot.ts",
    "morbius:medqa": "bun run scripts/medqa-harness.ts",
    "morbius:kaggle": "bun run scripts/kaggle-harness.ts",
    "morbius:skin": "bun run scripts/skin-lesion-harness.ts",
    "data:bootstrap": "bun run scripts/data-bootstrap.ts",
    "data:hf": "py scripts/hf-bulk-pull.py",
    "data:kaggle": "py scripts/kaggle-bulk-pull.py",
    "morbius:persona": "bun run scripts/persona-harness.ts",
    "morbius:soak": "bun run scripts/morbius-soak.ts",
    "morbius:brain:open": "powershell -ExecutionPolicy Bypass -File scripts/open-second-brain.ps1",
    "morbius:promote-tunes": "bun run scripts/morbius-promote-tunes.ts",
    "morbius:meta": "bun run scripts/morbius-meta-agent.ts",
    "morbius:demo-pin": "bun run scripts/morbius-demo-pin.ts",
    "morbius:hf-train": "bun run scripts/morbius-hf-train.ts",
    "morbius:tour": "bun run scripts/morbius-screenshot-tour.ts",
    "morbius:sync": "bun run scripts/morbius-sync.ts",
    "morbius:sync:watch": "bun run scripts/morbius-sync.ts --watch",
    "morbius:sync:local": "powershell -ExecutionPolicy Bypass -File scripts/sync-stage-to-v5.ps1",
    "morbius:bg": "powershell -ExecutionPolicy Bypass -File scripts/morbius-bg-services.ps1",
    "db:migrate": "bun run --filter @dr-abc/db db:migrate",
    "db:seed": "bun run --filter @dr-abc/db db:seed",
    "db:reset": "bun run db:migrate && bun run db:seed",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.13",
    "lefthook": "^1.7.22",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "typescript": "^5.6.3"
  },
  "trustedDependencies": ["@biomejs/biome", "lefthook"],
  "packageManager": "bun@1.3.13",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.6.1"
  }
}
