# syntax=docker/dockerfile:1.7
#
# Mörbius API — Bun runtime container.
#
# Build:  docker build -f Dockerfile.api -t morbius-api .
# Run:    docker run -p 8787:8787 -e ANTHROPIC_API_KEY=… morbius-api
#
# The image is multi-stage so the final layer ships only the runtime
# bun-installed workspace + the api source — no devDependencies, no
# build artifacts from other apps. ~150 MB on disk after pruning.

FROM oven/bun:1.3 AS deps
WORKDIR /app
COPY package.json bun.lock ./
COPY apps/api/package.json ./apps/api/
COPY packages/types/package.json ./packages/types/
COPY packages/morbius-core/package.json ./packages/morbius-core/
COPY packages/agents/package.json ./packages/agents/
COPY packages/db/package.json ./packages/db/
COPY packages/ui/package.json ./packages/ui/
RUN bun install --frozen-lockfile --production

FROM oven/bun:1.3 AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8787
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
# Source files — Bun runs TypeScript directly so no transpile step is
# needed for the API. The few packages the API imports also ship as
# raw .ts; Bun resolves them via workspace symlinks.
COPY apps/api ./apps/api
COPY packages ./packages
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD bun -e "fetch('http://localhost:8787/health').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"
CMD ["bun", "run", "apps/api/src/server.ts"]
